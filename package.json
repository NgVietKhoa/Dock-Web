{
  "name": "dock-web",
  "version": "0.3.3",
  "description": "Panel web luôn nằm trên cùng, dock vào cạnh màn hình",
  "main": "out/main/index.js",
  "scripts": {
    "start": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc",
    "dist": "electron-vite build && electron-builder --win --publish never"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "author": "Khoa",
  "build": {
    "appId": "com.khoa.dockweb",
    "productName": "Dock Web",
    "files": [
      "out/**"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "artifactName": "Dock-Web-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Dock Web"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/NgVietKhoa/Dock-Web.git"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.20.3",
    "electron-updater": "^6.8.11",
    "koffi": "^3.3.5"
  }
}
